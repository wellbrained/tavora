#!/usr/bin/env bash
# Checks Tavora's own signature on an app update before tavora-receive publishes it, the way the app does
# (apps/desktop/src/main/update-signature.ts): latest.yml's tavoraSignature must be an Ed25519 signature, by one
# of the two keys pinned in update-keys.ts, over
#   tavora-update-v1\n<version>\n<installer file name>\n<sha512 base64>
# so a stolen deploy key can't put an installer on the feed that Tavora's update key didn't sign. A second line,
# tavoraSignature2, may follow it (not required yet): the same fields plus the channel, the platform and when the
# statement was issued and expires, so an app can tell a feed held back from a fresh one. The signature
# doesn't cover the rest of latest.yml, so that must be exactly what electron-builder writes for this one installer
# (feed_problem): an older Tavora would also follow an extra `files` entry, an address, `packages` or
# `isAdminRightsRequired`.
# Installed by the maintainer as root:root 0755 in /usr/local/sbin, with the pins as /etc/tavora-deploy/update-keys.ts
# (both by setup-deploy-access.sh); a deploy never uploads or replaces either.
#
#   tavora-update-signature keys <update-keys.ts>
#       checks that the file pins two different keys (the setup runs this)
#   tavora-update-signature verify <update-keys.ts> <latest.yml> <version> <installer> <sha512> [<live latest.yml>]
#       exits 0 and prints which key signed it, or says why not (the layout or the signature) and exits 1; with the
#       live feed, a second signature must be issued after the live one's
#   tavora-update-signature refresh <update-keys.ts> <latest.yml> <version> <installer> <sha512> <live latest.yml>
#       the same for a refresh: the live version's feed byte for byte, but for a newer second signature
set -euo pipefail
export LC_ALL=C

die() { echo "tavora-update-signature: $*" >&2; exit 1; }

# Canonical base64 of exactly 32 or 64 bytes, like the app's isBase64Of: the last character before the padding
# carries no stray bits, so one value has one spelling.
readonly B64_32='[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]='
readonly B64_64='[A-Za-z0-9+/]{85}[AQgw]=='

# The two pinned keys, each 32 bytes of base64 (43 characters and one =), from update-keys.ts. Prints "release <key>"
# and "backup <key>".
read_keys() { # file
  local file="$1" name key
  [[ -f "$1" && -r "$1" ]] || die "no pinned update keys at $file (run the server setup again)"
  for name in release backup; do
    key="$(sed -nE "s|^  $name: \"($B64_32)\",?\$|\\1|p" "$file")"
    [[ "$(grep -cE "^  $name:" "$file")" == 1 && -n "$key" && "$key" != *$'\n'* ]] || die "update-keys.ts does not pin one $name key"
    echo "$name $key"
  done
}

# Why latest.yml is not exactly electron-builder's feed for this one installer (plus the signature line), or nothing.
# Each key once, each line exactly as written for <version>, <installer> and <sha512>; `files` holds one entry (url,
# sha512, size); `releaseNotes` is a plain `|` block whose lines are all indented by exactly two spaces, so none of
# them can be a key (it is text, and may name links). Outside it no address (://) and one `url:` line in all, so
# nothing can point an updater at another file. Before that, no control character but the line feed and no Unicode
# line or paragraph separator anywhere: a YAML reader breaks lines at a lone CR too, which would let a notes line start
# a key of its own. Keep in step with feedProblem in apps/desktop/scripts/update-feed.mjs.
readonly CONTROL_PROBLEM='latest.yml has a control character or a line separator the feed never has (a lone CR, a tab, NUL, U+0085, U+2028)'
feed_problem() { # latest.yml version installer sha512
  # C0 controls but LF, and DEL, counted byte by byte (NUL included); then the UTF-8 of C1 controls, U+2028, U+2029, U+FEFF.
  if (( $(LC_ALL=C tr -d '\000-\011\013-\037\177' < "$1" | wc -c) != $(wc -c < "$1") )) ||
    LC_ALL=C grep -q $'\xc2[\x80-\x9f]' "$1" || LC_ALL=C grep -qF -e $'\xe2\x80\xa8' -e $'\xe2\x80\xa9' -e $'\xef\xbb\xbf' "$1"; then
    echo "$CONTROL_PROBLEM"
    return 1
  fi
  awk -v version="$2" -v installer="$3" -v sha512="$4" '
    function fail(why) { print why; bad = 1; exit }
    # The second signature sits right after the first, nowhere else: a refresh swaps exactly that one line.
    { was_signature = after_signature; after_signature = 0 }
    state == "notes" { if ($0 == "" || $0 ~ /^  [^ ]/) next; state = "" }
    index($0, "://") { fail("latest.yml names an address (://); the feed only ever names the installer next to it") }
    /url:/ { if (++urls > 1) fail("latest.yml names more than one url") }
    state == "files" {
      entry++
      if (entry == 1 && $0 == "  - url: " installer) next
      if (entry == 2 && $0 == "    sha512: " sha512) next
      if (entry == 3 && $0 ~ /^    size: [1-9][0-9]*$/) { state = ""; next }
      fail("latest.yml'"'"'s files list must hold exactly this installer: its url, sha512 and size")
    }
    $0 == "version: " version { seen["version"]++; next }
    # Exactly the quoted canonical base64 of 64 bytes (17 + 1 + 88 + 1 characters, [AQgw] before the ==).
    $0 ~ /^tavoraSignature: '"'"'[A-Za-z0-9+\/]+=='"'"'$/ && length($0) == 107 && substr($0, 104, 1) ~ /[AQgw]/ { seen["tavoraSignature"]++; after_signature = 1; next }
    # The stable Windows feed'"'"'s statement: two UTC times and the quoted canonical base64 of 64 bytes (19 + 15 + 21 +
    # 21 + 88 + 1 characters, [AQgw] before the ==). No {n} counts: mawk may not have them.
    $0 ~ /^tavoraSignature2: '"'"'stable win-x64 [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z [A-Za-z0-9+\/]+=='"'"'$/ && length($0) == 165 && substr($0, 162, 1) ~ /[AQgw]/ {
      if (!was_signature) fail("latest.yml'"'"'s tavoraSignature2 line must come right after its tavoraSignature line")
      seen["tavoraSignature2"]++; next
    }
    $0 == "files:" { seen["files"]++; state = "files"; entry = 0; next }
    $0 == "path: " installer { seen["path"]++; next }
    $0 == "sha512: " sha512 { seen["sha512"]++; next }
    $0 == "releaseNotes: |" { seen["releaseNotes"]++; state = "notes"; next }
    $0 ~ /^releaseDate: '"'"'[0-9TZ:.-]+'"'"'$/ { seen["releaseDate"]++; next }
    { fail("latest.yml has a line electron-builder'"'"'s feed for " installer " never has: " substr($0, 1, 80)) }
    END {
      if (bad) exit 1
      if (state == "files") { print "latest.yml'"'"'s files list is cut off"; exit 1 }
      if (urls != 1) { print "latest.yml must name the installer in exactly one url"; exit 1 }
      n = split("version tavoraSignature files path sha512 releaseDate", once, " ")
      for (i = 1; i <= n; i++) if (seen[once[i]] != 1) { print "latest.yml must have exactly one " once[i] " line for this installer"; exit 1 }
      if (seen["tavoraSignature2"] > 1) { print "latest.yml has more than one tavoraSignature2 line"; exit 1 }
      if (seen["releaseNotes"] > 1) { print "latest.yml has more than one releaseNotes"; exit 1 }
    }
  ' "$1"
}

# An Ed25519 public key in PEM form: the 12-byte SubjectPublicKeyInfo prefix (16 base64 characters, no padding) and the raw 32 bytes.
pem() { printf -- '-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA%s\n-----END PUBLIC KEY-----\n' "$1"; }

command -v openssl >/dev/null || die 'openssl is missing'
case "${1:-}" in
  keys)
    [[ $# == 2 ]] || die 'usage: tavora-update-signature keys <update-keys.ts>'
    keys="$(read_keys "$2")"
    (( $(cut -d' ' -f2 <<< "$keys" | sort -u | wc -l) == 2 )) || die 'the release and backup update keys are the same key'
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    while read -r name key; do
      pem "$key" > "$work/$name.pem"
      openssl pkey -pubin -in "$work/$name.pem" -noout 2>/dev/null || die "the $name update key is not an Ed25519 public key"
    done <<< "$keys"
    # This openssl must check Ed25519 signatures over raw bytes (OpenSSL 3), or every publish would be refused.
    printf 'self-test' > "$work/signed"
    openssl genpkey -algorithm ed25519 -out "$work/test.key" 2>/dev/null &&
      openssl pkey -in "$work/test.key" -pubout -out "$work/test.pem" 2>/dev/null &&
      openssl pkeyutl -sign -inkey "$work/test.key" -rawin -in "$work/signed" -out "$work/test.sig" 2>/dev/null &&
      openssl pkeyutl -verify -pubin -inkey "$work/test.pem" -rawin -in "$work/signed" -sigfile "$work/test.sig" >/dev/null 2>&1 ||
      die "this openssl ($(openssl version)) can't check Ed25519 signatures; it needs OpenSSL 3"
    echo 'two pinned update keys'
    ;;
  verify | refresh)
    usage='usage: tavora-update-signature verify <update-keys.ts> <latest.yml> <version> <installer> <sha512> [<live latest.yml>] | refresh <same, live latest.yml required>'
    [[ $# == 6 || $# == 7 ]] || die "$usage"
    [[ "$1" == verify || $# == 7 ]] || die "$usage"
    keys="$(read_keys "$2")"
    feed="$3" version="$4" installer="$5" sha512="$6" live="${7:-}"
    # The same plain one-line fields the app accepts, so the signed text can't be read two ways.
    [[ "$version" =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]] || die "not a plain x.y.z version: $version"
    [[ "$installer" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$ ]] || die "not a plain file name: $installer"
    [[ "$sha512" =~ ^$B64_64$ ]] || die 'the SHA-512 is not 64 bytes of base64'
    [[ "$(grep -c '^tavoraSignature:' "$feed" || true)" == 1 ]] || die 'latest.yml has no Tavora signature (or more than one)'
    problem="$(feed_problem "$feed" "$version" "$installer" "$sha512")" || die "${problem:-latest.yml is unreadable}"
    # A refresh is the live feed again with only a newer second signature: the update key vouches that the live
    # version is still the newest. Nothing else may change.
    if [[ "$1" == refresh ]]; then
      [[ -f "$live" ]] || die 'there is no live feed to refresh'
      grep -qxF "version: $version" "$live" || die "$version is not the live version; a refresh only signs the live feed again"
      grep -q '^tavoraSignature2:' "$feed" || die 'the refresh carries no second signature'
      cmp -s <(grep -v '^tavoraSignature2:' "$live" || true) <(grep -v '^tavoraSignature2:' "$feed" || true) ||
        die 'the refresh changes more than the second signature'
    fi
    signature="$(sed -nE "s|^tavoraSignature: '($B64_64)'\$|\1|p" "$feed")"
    [[ -n "$signature" ]] || die "latest.yml's Tavora signature is not 64 bytes of base64"
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    printf 'tavora-update-v1\n%s\n%s\n%s' "$version" "$installer" "$sha512" > "$work/signed"
    printf '%s' "$signature" | openssl base64 -d -A > "$work/signature"
    (( $(wc -c < "$work/signature") == 64 )) || die "latest.yml's Tavora signature is not 64 bytes"
    while read -r name key; do pem "$key" > "$work/$name.pem"; done <<< "$keys"
    signer=""
    while read -r name key; do
      if openssl pkeyutl -verify -pubin -inkey "$work/$name.pem" -rawin -in "$work/signed" -sigfile "$work/signature" >/dev/null 2>&1; then
        signer="$name"
        break
      fi
    done <<< "$keys"
    [[ -n "$signer" ]] || die "the Tavora signature does not match $version, $installer and its SHA-512 under either pinned update key"
    echo "signed by the $signer update key"
    # The second signature (tavora-update-v2), when the feed has one; it isn't required yet. feed_problem took its line
    # only as the stable Windows feed's, right after the first. It must be a real statement: issued now or before
    # (10 minutes of clock leeway), not expired, at most 90 days long, later than the live feed's, and signed by a
    # pinned key over
    #   tavora-update-v2\n<version>\n<installer>\n<sha512>\n<channel>\n<platform>\n<issuedAt>\n<expiresAt>
    if grep -q '^tavoraSignature2:' "$feed"; then
      read -r channel platform issued expires signature2 <<< "$(sed -nE "s|^tavoraSignature2: '(.*)'\$|\1|p" "$feed")"
      for time in "$issued" "$expires"; do
        seconds="$(date -u -d "$time" +%s 2>/dev/null)" && [[ "$(date -u -d "@$seconds" +%Y-%m-%dT%H:%M:%SZ)" == "$time" ]] ||
          die "the second Tavora signature's time $time is not a real UTC time"
      done
      issued_s="$(date -u -d "$issued" +%s)" expires_s="$(date -u -d "$expires" +%s)" now="$(date -u +%s)"
      (( expires_s > issued_s )) || die 'the second Tavora signature expires before it was issued'
      (( expires_s - issued_s <= 90 * 86400 )) || die 'the second Tavora signature is good for more than 90 days'
      (( issued_s <= now + 600 )) || die "the second Tavora signature is issued in the future ($issued); is a clock wrong?"
      (( expires_s > now )) || die "the second Tavora signature expired at $expires"
      # The times have one spelling (checked above), so they compare as text.
      if [[ -n "$live" && -f "$live" ]]; then
        live_issued="$(sed -nE "s/^tavoraSignature2: '[a-z]+ [a-z0-9-]+ ([0-9TZ:-]+) .*'\$/\1/p" "$live" | head -n 1)"
        [[ -z "$live_issued" || "$issued" > "$live_issued" ]] || die "the second Tavora signature ($issued) is not later than the live one ($live_issued)"
      fi
      printf 'tavora-update-v2\n%s\n%s\n%s\n%s\n%s\n%s\n%s' "$version" "$installer" "$sha512" "$channel" "$platform" "$issued" "$expires" > "$work/signed2"
      printf '%s' "$signature2" | openssl base64 -d -A > "$work/signature2"
      (( $(wc -c < "$work/signature2") == 64 )) || die "latest.yml's second Tavora signature is not 64 bytes"
      signer2=""
      while read -r name key; do
        if openssl pkeyutl -verify -pubin -inkey "$work/$name.pem" -rawin -in "$work/signed2" -sigfile "$work/signature2" >/dev/null 2>&1; then
          signer2="$name"
          break
        fi
      done <<< "$keys"
      [[ -n "$signer2" ]] || die "the second Tavora signature does not match $version, $installer, its SHA-512, $channel $platform and its times under either pinned update key"
      echo "fresh until $expires, signed by the $signer2 update key"
    fi
    ;;
  *) die 'usage: tavora-update-signature keys <update-keys.ts> | verify <update-keys.ts> <latest.yml> <version> <installer> <sha512> [<live latest.yml>] | refresh <update-keys.ts> <latest.yml> <version> <installer> <sha512> <live latest.yml>' ;;
esac
