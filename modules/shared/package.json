{
  "name": "@tavora/official-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Theme, components and helpers shared by the official Tavora modules and the app. Bundled into each module and into the app; never loaded at runtime on its own.",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p ."
  },
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n.ts",
    "./theme.css": "./src/theme.css",
    "./components/*": "./src/components/*/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/vue": "1.57.0",
    "@tavora/sdk": "workspace:*",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "vue-tsc": "3.3.11"
  },
  "license": "MIT"
}
