{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "preserve",
    "noEmit": true,
    // shadcn-vue component sources in @tavora/official-ui are written without it.
    "exactOptionalPropertyTypes": false,
    // Libraries such as reka-ui also publish a "source" export; type-check
    // them from their builds and only the SDK from its sources.
    "customConditions": [],
    "paths": {
      "@tavora/pack/vite": ["../../packages/pack/src/vite.ts"],
      "@tavora/sdk": ["../../packages/sdk/src/index.ts"],
      "@tavora/sdk/bootstrap": ["../../packages/sdk/src/bootstrap.ts"],
      "@tavora/sdk/store": ["../../packages/sdk/src/store.ts"],
      "@tavora/sdk/testing": ["../../packages/sdk/src/testing.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../shared/src/env.d.ts"]
}
