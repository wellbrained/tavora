{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "vendor/core",
    "vite.config.ts"
  ],
  "exclude": [
    "vendor/core/**/__tests__/**"
  ]
}