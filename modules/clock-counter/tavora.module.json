{
  "$schema": "../../packages/module-schema/schema/tavora.module.schema.json",
  "id": "tavora.clock-counter",
  "name": "Clock & Counter",
  "description": "Countdowns, stopwatches and counters for this game, with hotkeys and overlays for your stream or over your game.",
  "version": "0.1.8",
  "apiVersion": "1",
  "entry": "dist/index.html",
  "overlay": "dist/overlay.html",
  "changelog": "changelog.json",
  "games": [],
  "viewport": { "minWidth": 280, "minHeight": 200, "preferredWidth": 360, "preferredHeight": 480 },
  "inGame": true,
  "actions": [
    { "id": "start-pause", "name": "Start/Pause" },
    { "id": "reset", "name": "Reset" },
    { "id": "lap", "name": "Lap" },
    { "id": "up", "name": "Count up" },
    { "id": "down", "name": "Count down" }
  ],
  "translations": {
    "de": {
      "description": "Countdowns, Stoppuhren und Zähler für dieses Spiel, mit Hotkeys und Overlays für deinen Stream oder über deinem Spiel.",
      "actions": {
        "reset": "Zurücksetzen",
        "lap": "Runde",
        "up": "Hochzählen",
        "down": "Runterzählen"
      }
    }
  },
  "permissions": { "network": [], "connectors": ["stream-overlay"], "onRequest": ["stream-overlay"] }
}
