<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads icons and MAM research trees from the game's IoStore files. Run through tools/extract-data.ts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202610" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202610" />
    <!-- Lifts a transitive version with a published advisory to a fixed release. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- ImageSharp 3.1 comes with CUE4Parse-Conversion. Its advisories concern decoding untrusted image files;
         this tool only decodes textures from the local game install and encodes with SkiaSharp. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>
</Project>
