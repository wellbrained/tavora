{
  "$schema": "../../packages/module-schema/schema/tavora.module.schema.json",
  "id": "local.poe2-builds",
  "name": "PoE 2 Builds",
  "description": "Offline build viewer with passive tree, skills, gear and guide panels. Load and share Tavora build files.",
  "version": "0.1.0-alpha.15",
  "apiVersion": "1",
  "minTavora": "0.17.20",
  "entry": "dist/index.html",
  "games": [
    "poe2"
  ],
  "viewport": {
    "minWidth": 300,
    "minHeight": 240,
    "preferredWidth": 560,
    "preferredHeight": 600
  },
  "panels": [
    {
      "id": "tree",
      "name": "Tree",
      "viewport": {
        "minWidth": 400,
        "minHeight": 360,
        "preferredWidth": 760,
        "preferredHeight": 650
      },
      "icon": "dist/assets/icons/panel-tree.png"
    },
    {
      "id": "skills",
      "name": "Skills",
      "icon": "dist/assets/icons/panel-skills.png"
    },
    {
      "id": "gear",
      "name": "Gear",
      "icon": "dist/assets/icons/panel-gear.png",
      "viewport": {
        "minWidth": 400,
        "minHeight": 608,
        "preferredWidth": 568,
        "preferredHeight": 680
      }
    },
    {
      "id": "guide",
      "name": "Guide",
      "icon": "dist/assets/icons/panel-guide.png"
    }
  ],
  "permissions": {
    "network": []
  },
  "icon": "dist/assets/icons/panel-gear.png"
}
