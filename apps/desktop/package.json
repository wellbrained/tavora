{
  "name": "@tavora/desktop",
  "version": "0.23.48",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p . && vue-tsc --noEmit -p src/renderer",
    "test:e2e": "playwright test",
    "package": "electron-builder",
    "release": "node scripts/release.mjs",
    "release:fold": "node scripts/fold-notes.mjs",
    "dev": "node --conditions=source scripts/dev.mjs",
    "perf:system-info": "node scripts/perf-system-info.mjs",
    "perf:media": "node scripts/perf-media.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@ghostery/adblocker": "2.20.1",
    "@lucide/vue": "1.57.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tavora/module-schema": "workspace:*",
    "@tavora/official-ui": "workspace:*",
    "@tavora/pack": "workspace:*",
    "@tavora/sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dockview-vue": "8.3.1",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tldts": "7.4.18",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "main": "out/main/index.cjs",
  "license": "MIT",
  "description": "Second-monitor gaming companion",
  "author": "Tavora",
  "build": {
    "appId": "gg.tavora.desktop",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "extraMetadata": {
      "name": "Tavora"
    },
    "productName": "Tavora",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "assets/**",
      "!assets/filters/**",
      "package.json",
      "!out/**/*.map"
    ],
    "asar": false,
    "electronLanguages": [
      "en-US",
      "de"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../examples",
        "to": "modules",
        "filter": [
          "*/tavora.module.json",
          "*/changelog.json",
          "*/dist/**",
          "*/src/**",
          "*/package.json",
          "*/tsconfig.json",
          "*/vite.config.ts"
        ]
      },
      {
        "from": "../../modules",
        "to": "official-modules",
        "filter": [
          "*/tavora.module.json",
          "*/changelog.json",
          "*/dist/**"
        ]
      },
      {
        "from": "../../themes",
        "to": "official-themes",
        "filter": [
          "*/tavora.theme.json"
        ]
      },
      {
        "from": "../../packages/media-helper/bin",
        "to": "media-helper",
        "filter": [
          "tavora-media.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/tavora.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon-256.png",
      "category": "Game",
      "executableName": "tavora"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tavora",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tavora-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.mytavora.app"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3"
  }
}
