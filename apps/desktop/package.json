{
  "name": "@tavora/desktop",
  "version": "0.24.109",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p . && vue-tsc --noEmit -p src/renderer",
    "test:e2e": "playwright test",
    "package": "electron-builder",
    "release": "node scripts/release.mjs",
    "release:fold": "node scripts/fold-notes.mjs",
    "dev": "node --conditions=source scripts/dev.mjs",
    "perf:system-info": "node scripts/perf-system-info.mjs",
    "perf:media": "node scripts/perf-media.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@ghostery/adblocker": "2.20.3",
    "@lucide/vue": "1.74.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tavora/module-schema": "workspace:*",
    "@tavora/official-ui": "workspace:*",
    "@tavora/pack": "workspace:*",
    "@tavora/sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vueuse/core": "15.0.0",
    "dockview-vue": "8.9.0",
    "electron": "44.11.3",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "reka-ui": "2.11.0",
    "tailwindcss": "4.3.5",
    "tldts": "7.5.4",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "main": "out/main/index.cjs",
  "license": "MIT",
  "description": "Second-monitor gaming companion",
  "author": "Tavora",
  "build": {
    "appId": "gg.tavora.desktop",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "extraMetadata": {
      "name": "Tavora"
    },
    "productName": "Tavora",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "assets/**",
      "!assets/filters/**",
      "package.json",
      "!out/**/*.map",
      "!out/licences/THIRD_PARTY_NOTICES.txt",
      "!out/release-notes.md"
    ],
    "asar": true,
    "asarUnpack": [
      "out/main/system-info-worker.cjs",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "electronLanguages": [
      "en-US",
      "de"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "out/licences",
        "to": ".",
        "filter": [
          "THIRD_PARTY_NOTICES.txt"
        ]
      },
      {
        "from": "../../examples",
        "to": "modules",
        "filter": [
          "*/tavora.module.json",
          "*/changelog.json",
          "*/dist/**",
          "*/src/**",
          "*/package.json",
          "*/tsconfig.json",
          "*/vite.config.ts"
        ]
      },
      {
        "from": "../../modules",
        "to": "official-modules",
        "filter": [
          "*/tavora.module.json",
          "*/changelog.json",
          "*/dist/**"
        ]
      },
      {
        "from": "../../themes",
        "to": "official-themes",
        "filter": [
          "*/tavora.theme.json"
        ]
      },
      {
        "from": "../../styles",
        "to": "official-styles",
        "filter": [
          "*/tavora.style.json"
        ]
      },
      {
        "from": "../../packages/media-helper/bin",
        "to": "media-helper",
        "filter": [
          "tavora-media.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/tavora.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tavora",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tavora-Setup-${version}.exe"
    },
    "releaseInfo": {
      "releaseNotesFile": "out/release-notes.md"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.mytavora.app"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.12",
    "koffi": "^3.3.8"
  }
}
