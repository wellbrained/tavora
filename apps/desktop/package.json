{
  "name": "@tavora/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p . && vue-tsc --noEmit -p src/renderer",
    "test:e2e": "playwright test",
    "package": "electron-builder",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/vue": "1.57.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tavora/module-schema": "workspace:*",
    "@tavora/sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11",
    "dockview-vue": "8.3.1"
  },
  "main": "out/main/index.cjs",
  "license": "MIT",
  "description": "Second-monitor gaming companion",
  "build": {
    "appId": "gg.tavora.desktop",
    "productName": "Tavora",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "assets/**",
      "package.json",
      "!out/**/*.map"
    ],
    "asar": false,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../examples",
        "to": "modules",
        "filter": [
          "*/tavora.module.json",
          "*/dist/**"
        ]
      },
      {
        "from": "../../modules",
        "to": "official-modules",
        "filter": [
          "*/tavora.module.json",
          "*/dist/**"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/tavora.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon-256.png",
      "category": "Game",
      "executableName": "tavora"
    },
    "portable": {
      "artifactName": "Tavora-${version}-portable.exe"
    }
  }
}
