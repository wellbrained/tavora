{
  "$comment": "Tags for patch-notes entries, from the files a pull request changed (change-notes.mjs). For Tavora Admin only; users never see them. In a path, * is anything but a slash and ** anything at all. Add a line when a new area turns up.",
  "tags": [
    { "tag": "overlays", "paths": ["apps/desktop/src/main/*overlay*", "apps/desktop/src/main/game-veil*", "apps/desktop/src/renderer/**/*verlay*"] },
    { "tag": "workspace", "paths": ["apps/desktop/src/renderer/components/workspace/**", "apps/desktop/src/renderer/dock*", "apps/desktop/src/renderer/layout*", "apps/desktop/src/renderer/pages/WorkspacePage.vue", "apps/desktop/src/main/workspace*", "apps/desktop/src/main/layout*", "apps/desktop/src/main/panel-*"] },
    { "tag": "rail", "paths": ["apps/desktop/src/renderer/components/Rail*", "apps/desktop/src/renderer/components/WorkspaceRail.vue", "apps/desktop/src/renderer/rail-*"] },
    { "tag": "games", "paths": ["apps/desktop/src/main/games*", "apps/desktop/src/main/game-watch*", "apps/desktop/src/main/launcher-games*", "apps/desktop/src/main/library*", "apps/desktop/src/main/steam*", "apps/desktop/src/renderer/components/AddGameDialog.vue", "apps/desktop/src/renderer/components/SteamImportDialog.vue", "apps/desktop/src/renderer/components/RunningGameButton.vue"] },
    { "tag": "icons", "paths": ["apps/desktop/src/main/*icon*", "apps/desktop/src/renderer/components/ShareIconsDialog.vue", "apps/desktop/src/renderer/components/WorkspaceIcon.vue", "apps/api/src/icon*", "apps/api/src/submissions*", "apps/api/src/hosted-store*", "apps/api/data/icons/**"] },
    { "tag": "catalog", "paths": ["apps/desktop/src/main/catalog*", "apps/desktop/src/renderer/components/Catalog*", "apps/api/src/catalog*", "apps/api/src/moderation*", "apps/api/src/reviews*"] },
    { "tag": "modules", "paths": ["apps/desktop/src/main/module-*", "apps/desktop/src/main/moved-modules*", "apps/desktop/src/renderer/components/Module*", "apps/desktop/src/renderer/components/AddModuleDialog.vue", "apps/desktop/src/renderer/module-*"] },
    { "tag": "publishing", "paths": ["apps/desktop/src/main/module-publish*", "apps/desktop/src/main/developer-*", "apps/desktop/src/renderer/components/developer/**", "apps/desktop/src/renderer/developer-*", "packages/create-module/**", "packages/pack/**", "packages/module-schema/**", "apps/api/src/publish*", "apps/api/src/key-requests*"] },
    { "tag": "sdk", "paths": ["packages/sdk/**"] },
    { "tag": "accounts", "paths": ["apps/desktop/src/main/account*", "apps/desktop/src/renderer/components/profile/**", "apps/api/src/account*", "apps/api/src/auth*", "apps/api/src/mail*"] },
    { "tag": "cloud-copy", "paths": ["apps/desktop/src/main/cloud-copy*", "apps/desktop/src/main/copy-*", "apps/desktop/src/main/backup*", "apps/desktop/src/main/pairing*", "apps/desktop/src/renderer/components/CloudCopyDialog.vue", "apps/desktop/src/renderer/components/PairingDialog.vue", "apps/api/src/cloud*", "apps/api/src/vault*"] },
    { "tag": "settings", "paths": ["apps/desktop/src/renderer/components/settings/**", "apps/desktop/src/main/settings*"] },
    { "tag": "hotkeys", "paths": ["apps/desktop/src/main/hotkeys*", "apps/desktop/src/renderer/shortcuts*", "apps/desktop/src/renderer/components/HotkeyDialog.vue"] },
    { "tag": "discord", "paths": ["apps/desktop/src/main/discord*", "modules/discord/**"] },
    { "tag": "media", "paths": ["apps/desktop/src/main/media*", "packages/media-helper/**"] },
    { "tag": "ai-usage", "paths": ["apps/desktop/src/main/ai-usage*"] },
    { "tag": "system-monitor", "paths": ["modules/system-monitor/**", "apps/desktop/src/main/connection*", "apps/desktop/src/main/system*", "apps/desktop/src/main/traffic*"] },
    { "tag": "calculator", "paths": ["modules/calculator/**"] },
    { "tag": "clock-counter", "paths": ["modules/clock-counter/**"] },
    { "tag": "notes", "paths": ["modules/notes/**"] },
    { "tag": "pdf-viewer", "paths": ["modules/pdf-viewer/**"] },
    { "tag": "todos", "paths": ["modules/todos/**"] },
    { "tag": "whiteboard", "paths": ["modules/whiteboard/**"] },
    { "tag": "ui-kit", "paths": ["modules/shared/**", "modules/playground/**"] },
    { "tag": "updates", "paths": ["apps/desktop/src/main/updater*", "apps/desktop/src/main/installer*", "apps/desktop/src/main/update*", "apps/desktop/build/**", "apps/desktop/electron-builder*"] },
    { "tag": "onboarding", "paths": ["apps/desktop/src/renderer/pages/OnboardingPage.vue", "apps/desktop/src/renderer/pages/WelcomePage.vue"] },
    { "tag": "privacy", "paths": ["apps/desktop/src/main/online*", "apps/desktop/src/main/grants*", "apps/desktop/src/main/network*", "apps/desktop/src/renderer/components/GrantDialog.vue", "apps/docs/guide/security.md", "apps/docs/**/privacy*"] },
    { "tag": "stats", "paths": ["apps/api/src/stats*"] },
    { "tag": "service", "paths": ["apps/api/src/**"] },
    { "tag": "website", "paths": ["apps/docs/**"] }
  ]
}
