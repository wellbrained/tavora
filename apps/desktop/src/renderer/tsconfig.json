{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // Libraries that also publish a "source" export are type-checked from
    // their builds. The only workspace package here, @tavora/official-ui,
    // ships plain sources.
    "customConditions": [],
    // shadcn-vue component sources (@tavora/official-ui) are written without it.
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.vue", "../shared/**/*.ts"]
}
