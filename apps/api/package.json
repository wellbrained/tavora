{
  "name": "@tavora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tavora's online game database: search over its own dataset.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --conditions=source src/server.ts",
    "dev": "node --watch --conditions=source src/server.ts",
    "dataset": "node scripts/build-dataset.ts",
    "icon": "node scripts/icon.ts",
    "catalog": "node --conditions=source scripts/catalog.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --conditions=source --outfile=dist/server.mjs && esbuild scripts/catalog.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --conditions=source --outfile=dist/catalog.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "mmdb-lib": "3.0.3"
  },
  "devDependencies": {
    "@tavora/module-schema": "workspace:*",
    "@tavora/pack": "workspace:*",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2"
  }
}
