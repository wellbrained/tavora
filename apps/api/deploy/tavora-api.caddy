api.mytavora.app {
    bind 167.233.235.154 2a01:4f8:c013:d350::1
    encode zstd gzip
    header X-Content-Type-Options nosniff
    # No request is bigger than a profile with its picture (about 700 KB), except a module zip published
    # to the catalog (at most the installer's 50 MB) and a cloud copy upload (about 8 MB of parts, or a
    # manifest with its part list); the service checks each route again.
    @publish path /v1/catalog/publish
    request_body @publish {
        max_size 50MB
    }
    @copy path /v1/account/copy /v1/account/copy/*
    request_body @copy {
        max_size 10MB
    }
    @other not path /v1/catalog/publish /v1/account/copy /v1/account/copy/*
    request_body @other {
        max_size 1MB
    }
    # The service rate-limits per client from the first X-Forwarded-For address,
    # so the proxy sets it and never passes on what a client sent.
    # No access log is configured on purpose: requests hold what players typed.
    # /internal/ is for the update feed's web server (it counts installer downloads), never the public.
    handle /internal/* {
        respond 404
    }
    handle {
        reverse_proxy 127.0.0.1:4010 {
            header_up X-Forwarded-For {remote_host}
        }
    }
}
