{
  "name": "@tavora/sdk",
  "version": "0.3.6",
  "description": "Typed client for Tavora modules: talks to the Tavora Desktop host over its bridge.",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "tavora",
    "module",
    "sdk",
    "gaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellbrained/tavora.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.mytavora.app/",
  "bugs": "https://github.com/wellbrained/tavora/issues",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "source": "./src/bootstrap.ts",
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./store": {
      "source": "./src/store.ts",
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./bootstrap": {
        "types": "./dist/bootstrap.d.ts",
        "default": "./dist/bootstrap.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "./store": {
        "types": "./dist/store.d.ts",
        "default": "./dist/store.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT"
}
