{
  "name": "@tavora/create-module",
  "version": "0.1.21",
  "description": "Makes a new Tavora module project: npm create @tavora/module.",
  "type": "module",
  "keywords": [
    "tavora",
    "module",
    "create",
    "starter",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellbrained/tavora.git",
    "directory": "packages/create-module"
  },
  "homepage": "https://docs.mytavora.app/guide/getting-started",
  "bugs": "https://github.com/wellbrained/tavora/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-module": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@tavora/module-schema": "workspace:^"
  },
  "devDependencies": {
    "@tavora/sdk": "workspace:*",
    "@types/node": "^22.20.5"
  },
  "license": "MIT"
}
