{
  "name": "tavora",
  "version": "0.20.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tavora/desktop dev",
    "typecheck": "pnpm -r --filter \"!@tavora/docs\" typecheck",
    "build": "pnpm -r --filter \"!@tavora/docs\" build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @tavora/desktop test:e2e",
    "release": "pnpm --filter @tavora/desktop release",
    "release:sdk": "node scripts/release-sdk.mjs",
    "pack-module": "node --experimental-strip-types --disable-warning=ExperimentalWarning --conditions=source packages/pack/src/cli.ts",
    "tavora-pack": "node --experimental-strip-types --disable-warning=ExperimentalWarning --conditions=source packages/pack/src/cli.ts",
    "tavora-catalog-sign": "node --experimental-strip-types --disable-warning=ExperimentalWarning --conditions=source scripts/catalog-sign.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "dockview": "8.3.1",
      "dockview-core": "8.3.1"
    },
    "patchedDependencies": {
      "@excalidraw/excalidraw@0.18.1": "patches/@excalidraw__excalidraw@0.18.1.patch"
    }
  },
  "license": "MIT"
}
