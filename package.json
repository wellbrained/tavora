{
  "name": "tavora",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tavora/desktop dev",
    "typecheck": "pnpm -r --filter \"!@tavora/docs\" typecheck",
    "build": "pnpm -r --filter \"!@tavora/docs\" build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @tavora/desktop test:e2e",
    "release": "pnpm --filter @tavora/desktop release",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "dockview": "8.3.1",
      "dockview-core": "8.3.1"
    }
  },
  "license": "MIT"
}
