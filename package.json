{
  "name": "tavora",
  "version": "0.24.12",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tavora/desktop dev",
    "typecheck": "pnpm -r --filter \"!@tavora/docs\" typecheck",
    "build": "pnpm -r --filter \"!@tavora/docs\" build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @tavora/desktop test:e2e",
    "release": "pnpm --filter @tavora/desktop release",
    "perf:system-info": "pnpm --filter @tavora/desktop perf:system-info",
    "perf:media": "pnpm --filter @tavora/desktop perf:media",
    "release:fold": "pnpm --filter @tavora/desktop release:fold",
    "release:sdk": "node scripts/release-sdk.mjs",
    "pack-module": "node --experimental-strip-types --disable-warning=ExperimentalWarning --conditions=source packages/pack/src/cli.ts",
    "tavora-pack": "node --experimental-strip-types --disable-warning=ExperimentalWarning --conditions=source packages/pack/src/cli.ts",
    "tavora-catalog-sign": "node --experimental-strip-types --disable-warning=ExperimentalWarning --conditions=source scripts/catalog-sign.ts",
    "check:patches": "node scripts/check-patches.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "lint": "oxlint && node scripts/check-modules.mjs",
    "check": "pnpm check:patches && pnpm check:modules && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "30.1.3",
    "oxlint": "1.91.0",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "dockview": "8.8.3",
      "dockview-core": "8.8.3"
    },
    "patchedDependencies": {
      "@excalidraw/excalidraw@0.18.1": "patches/@excalidraw__excalidraw@0.18.1.patch"
    }
  },
  "license": "MIT"
}
